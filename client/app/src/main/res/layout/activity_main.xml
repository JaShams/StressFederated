<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent" >

<!--    <LinearLayout-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:orientation="horizontal">-->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >

        <TextView
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text=""
            android:textSize="20sp"
            android:textAlignment="center"
            android:layout_marginTop="10dp"
            android:id="@+id/result" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Stress Detection"
            android:textSize="20sp"
            android:textAlignment="center"
            android:layout_marginTop="20dp" />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="BT"
            android:id="@+id/bt"
            android:layout_marginTop="10dp"
            android:imeOptions="actionDone"
            android:lines="1"
            android:autofillHints=""
             />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="BO"
            android:id="@+id/bo"
            android:layout_marginTop="20dp"
            android:imeOptions="actionDone" />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="SH"
            android:id="@+id/sh"
            android:layout_marginTop="20dp"
            android:imeOptions="actionDone"
            android:autofillHints="" />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="HR"
            android:id="@+id/hr"
            android:layout_marginTop="20dp"
            android:imeOptions="actionDone"
            android:autofillHints=""
             />
    <TextView
        android:id="@+id/questionTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="In the last month, how often have you felt that you were unable to control the important things in your life?"
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="16dp" />

    <RadioGroup
        android:id="@+id/radioGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <RadioButton
            android:id="@+id/option1RadioButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="18sp"
            android:paddingEnd="16dp" />

        <RadioButton
            android:id="@+id/option2RadioButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1"
            android:textSize="18sp"
            android:paddingEnd="16dp" />

        <RadioButton
            android:id="@+id/option3RadioButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2"
            android:textSize="18sp"
            android:paddingEnd="16dp" />

        <RadioButton
            android:id="@+id/option4RadioButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3"
            android:textSize="18sp"
            android:paddingEnd="16dp" />

        <RadioButton
            android:id="@+id/option5RadioButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4"
            android:textSize="18sp"
            android:paddingEnd="16dp" />
    </RadioGroup>

    <Button
        android:id="@+id/nextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Next"
        android:textSize="18sp"
        android:padding="16dp" />

    <Button
        android:id="@+id/predict"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="predict"
        />
    <EditText
        android:id="@+id/device_id_edit_text"
        style="@style/Widget.Material3.TextInputEditText.FilledBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:fontFamily="@font/montserrat_light"
        android:hint="Client Partition ID (1-10)"
        android:inputType="numberDecimal"
        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
        android:textColor="#4a5663"
        android:autofillHints="" />

    <EditText
        android:id="@+id/serverIP"
        style="@style/Widget.Material3.TextInputEditText.FilledBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:fontFamily="@font/montserrat_light"
        android:hint="FL Server IP"
        android:inputType="phone"
        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
        android:textColor="#4a5663"
        android:autofillHints="" />


    <EditText
        android:id="@+id/serverPort"
        style="@style/Widget.Material3.TextInputEditText.FilledBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:fontFamily="@font/montserrat_light"
        android:hint="FL Server Port"
        android:inputType="numberDecimal"
        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
        android:textColor="#4a5663"
        android:autofillHints="" />


    <Button
        android:id="@+id/load_data"
        style="@android:style/Widget.Material.Button.Colored"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="10sp"
        android:background="@drawable/rounded_corner"
        android:backgroundTint="#F2B705"
        android:fontFamily="@font/share_tech_mono"
        android:onClick="loadData"
        android:text="Load Dataset" />


    <Button
        android:id="@+id/connect"
        style="@android:style/Widget.Material.Button.Colored"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="5sp"
        android:background="@drawable/rounded_corner"
        android:backgroundTint="#F2B705"
        android:enabled="false"
        android:fontFamily="@font/share_tech_mono"
        android:onClick="connect"
        android:text="Setup Connection Channel" />

    <Button
        android:id="@+id/trainFederated"
        style="@android:style/Widget.Material.Button.Colored"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="5sp"
        android:background="@drawable/rounded_corner"
        android:backgroundTint="#F2B705"
        android:enabled="false"
        android:fontFamily="@font/share_tech_mono"
        android:onClick="runGRPC"
        android:text="Train Federated!" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="25sp"
        android:fontFamily="@font/montserrat_medium"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:text="Activity Log"
        android:textAlignment="center"
        android:textColor="#4a5663"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/grpc_response_text"
        android:layout_width="395dp"
        android:layout_height="267dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/rounded_corner"
        android:backgroundTint="#4a5663"
        android:fontFamily="@font/share_tech_mono"
        android:gravity="bottom"
        android:nestedScrollingEnabled="true"
        android:overScrollMode="always"
        android:scrollbarAlwaysDrawHorizontalTrack="false"
        android:scrollbars="vertical"
        android:text="Welcome to Flower! \n"
        android:textAppearance="@style/TextAppearance.AppCompat.Body1"
        android:textColor="#f2f2f2"
        android:textSize="12sp"
        android:verticalScrollbarPosition="defaultPosition" />

    </LinearLayout>

</ScrollView>